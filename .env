# Created by: devops-agent (DevOps Engineer)
# Copy to .env.local for local development. On Vercel, set these in the
# project Environment Variables settings.

# Storage mode: "json" (default, zero-config) or "postgres" (production)
DATA_MODE=json

# Absolute or workspace-relative path to the JSON database file (json mode)
JSON_DB_PATH=./data/db.json

# PostgreSQL connection string (postgres mode only)
# Example: postgres://user:password@host:5432/taskflow
DATABASE_URL=
